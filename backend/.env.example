# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Format: host=<host> user=<user> password=<pass> dbname=<db> port=<port> sslmode=<mode> TimeZone=UTC
DATABASE_URL=host=localhost user=postgres password=changeme dbname=learnthor port=5432 sslmode=disable TimeZone=UTC

# ── App ───────────────────────────────────────────────────────────────────────
# Environment: development | production
APP_ENV=development

# ── Auth (JWT) ────────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -hex 32
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRY_HOURS=24

# ── Midtrans (payments) ───────────────────────────────────────────────────────
# Get keys from https://dashboard.midtrans.com → Settings → Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
# sandbox for testing, production for live payments
MIDTRANS_ENV=sandbox
# One-time premium price in IDR (default 99000 = Rp 99.000)
PREMIUM_PRICE_IDR=99000
