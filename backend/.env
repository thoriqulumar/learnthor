# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Format: host=<host> user=<user> password=<pass> dbname=<db> port=<port> sslmode=<mode> TimeZone=UTC
DATABASE_URL=host=localhost user=postgres password=changeme dbname=learnthor port=5433 sslmode=disable TimeZone=UTC

# ── App ───────────────────────────────────────────────────────────────────────
# Environment: development | production
APP_ENV=development

# ── Auth (JWT) ────────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -hex 32
JWT_SECRET=aa224fc9993d3d49ca5849d08aa8943151c8f9bbe55f54e8612a2a46715ed6fd
JWT_EXPIRY_HOURS=24
