# ── PostgreSQL ────────────────────────────────────────────────────────────────
# These are used by the `db` service in docker-compose.yml to initialise the
# database, AND by the backend via DATABASE_URL below.
POSTGRES_USER=learnthor
POSTGRES_PASSWORD=7c878a6cb172139dcdeb4fa204a1a462b96ee917ed685ce1
POSTGRES_DB=learnthor

# ── Backend (Go) ─────────────────────────────────────────────────────────────
# host=db points at the compose service name, not localhost.
PORT=8080
APP_ENV=production
DATABASE_URL=host=db user=learnthor password=7c878a6cb172139dcdeb4fa204a1a462b96ee917ed685ce1 dbname=learnthor port=5432 sslmode=disable TimeZone=UTC

# Generate with:  openssl rand -hex 32
JWT_SECRET=b75d48c2cbcb091bc3362c0682c67857f028fdbfa43f2618d4598907815e3657

# ── Midtrans (payments) ───────────────────────────────────────────────────────
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
MIDTRANS_ENV=sandbox
PREMIUM_PRICE_IDR=99000
