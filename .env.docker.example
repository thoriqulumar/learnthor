# ── PostgreSQL ────────────────────────────────────────────────────────────────
# These are used by the `db` service in docker-compose.yml to initialise the
# database, AND by the backend via DATABASE_URL below.
POSTGRES_USER=learnthor
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=learnthor

# ── Backend (Go) ─────────────────────────────────────────────────────────────
# host=db points at the compose service name, not localhost.
PORT=8080
APP_ENV=production
DATABASE_URL=host=db user=learnthor password=CHANGE_ME_STRONG dbname=learnthor port=5432 sslmode=disable TimeZone=UTC

# Generate with:  openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_64_HEX_CHARS

# ── Midtrans (payments) ───────────────────────────────────────────────────────
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
MIDTRANS_ENV=sandbox
PREMIUM_PRICE_IDR=99000
